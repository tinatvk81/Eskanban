#!/usr/bin/env bash
# Block secrets-like files and oversized files from being committed.
set -euo pipefail

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

while IFS= read -r f; do
  base=$(basename "$f")
  if [[ $base == .env || $base == .env.* ]] && [[ $base != *.example ]]; then
    echo "pre-commit: refusing to commit '$f' (env files hold secrets; use .env.example)." >&2
    exit 1
  fi
  if [ -f "$f" ] && (( $(wc -c < "$f") > 5242880 )); then
    echo "pre-commit: '$f' is larger than 5 MB; store large assets outside git." >&2
    exit 1
  fi
done <<< "$staged"
