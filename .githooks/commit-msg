#!/usr/bin/env bash
# Enforce the Conventional Commits 1.0.0 header with this project's profile.
# Reasoning: docs/adr/0002-git-workflow-and-versioning.md
set -euo pipefail

header=$(head -n1 "$1")

# Messages generated by git itself.
if [[ $header =~ ^(Merge|Revert\ \"|fixup!|squash!|amend!) ]]; then
  exit 0
fi

shopt -s nocasematch
types='feat|fix|docs|refactor|perf|test|build|ci|chore|style|revert'
pattern="^($types)(\([a-z0-9][a-z0-9-]*\))?!?: [^ ].*$"

if [[ ! $header =~ $pattern ]]; then
  cat >&2 <<MSG
commit-msg: header does not follow Conventional Commits.
  got:      $header
  expected: <type>(<scope>)!: <description>
  types:    ${types//|/, }
  example:  feat(files): add saved filter presets
See docs/adr/0002-git-workflow-and-versioning.md
MSG
  exit 1
fi

if (( ${#header} > 72 )); then
  echo "commit-msg: header is ${#header} characters; keep it at 72 or fewer." >&2
  exit 1
fi
