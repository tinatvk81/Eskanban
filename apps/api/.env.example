# Environment: local | staging | production
ESKANBAN_ENV=local
# Comma-separated list of allowed browser origins (the web app URL)
ESKANBAN_CORS_ORIGINS=http://localhost:3000
# PostgreSQL. postgres:// and postgresql:// URLs from hosting panels are accepted as-is.
ESKANBAN_DATABASE_URL=postgresql+psycopg://eskanban:eskanban@localhost:5432/eskanban
# Used only by the test suite (a separate, disposable database)
ESKANBAN_TEST_DATABASE_URL=postgresql+psycopg://eskanban:eskanban@localhost:5432/eskanban_test
